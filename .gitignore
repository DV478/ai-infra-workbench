!data/raw/market/
data/processed/*
!data/processed/.gitkeep
data/traces/*
!data/traces/.gitkeep

# Prices DB is the one data file we DO want committed — it's the whole point
# of the weekly logger. Do not add data/prices to gitignore.

# Generated market-intel DB — regenerate with scripts/run_market_intel.py
data/market_intel.duckdb

# Advisor turn log — accumulates locally per Streamlit server; regenerated by use.
data/advisor_turns.duckdb

# Generated eval reports — regenerate with scripts/run_eval.py / run_market_intel_eval.py
eval_report.md
market_intel_eval_report.md

